<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_otp_box"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/IMG_AVATAR"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_volt" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/IMG_AVATAR"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TXT_USERNAME_REVIEW"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TXT_RATING_STARS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★"
                android:textColor="#FFC107"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/TXT_TIME_REVIEW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Hôm nay"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/TXT_COMMENT_REVIEW"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nội dung đánh giá..."
        android:textColor="#D0D0D0" />

</LinearLayout>
