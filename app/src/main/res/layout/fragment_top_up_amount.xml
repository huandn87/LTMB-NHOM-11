<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nạp tiền"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Nhập số tiền cần nạp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_amount_box"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:minHeight="92dp"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:rowCount="3"
                android:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip10k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="10.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip20k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="20.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip30k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="30.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip50k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="50.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip100k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="100.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip200k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="200.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip300k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="300.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip400k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="400.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip500k"
                    style="@style/WalletChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="500.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brand_green" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Phương thức thanh toán"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Xác nhận nạp tiền"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/brand_green"
        app:cornerRadius="18dp" />

</LinearLayout>
