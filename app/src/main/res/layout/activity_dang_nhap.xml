<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/DEN_NEN"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="30dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/anh_dang_nhap" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Đăng nhập nào !!"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Chào mừng trở lại 👋"
            android:textColor="#A0A0A0"
            android:textSize="14sp" />

        <!-- Trường Tên đăng nhập -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Tên đăng nhập"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/XANH_NEON"
            app:hintTextColor="@color/XANH_NEON"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EDT_USERNAME"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên đăng nhập"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#606060" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trường Mật khẩu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Mật khẩu"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/XANH_NEON"
            app:hintTextColor="@color/XANH_NEON"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/XANH_NEON"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EDT_PASS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập mật khẩu"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:textColorHint="#606060" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quên mật khẩu -->
        <TextView
            android:id="@+id/TV_QUEN_MAT_KHAU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="20dp"
            android:text="Quên mật khẩu?"
            android:textColor="@color/XANH_NEON"
            android:padding="4dp" />

        <!-- Nút Đăng nhập -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BTN_DANG_NHAP_SDT"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/XANH_NEON"
            android:text="Đăng nhập"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            android:elevation="8dp" />

        <!-- Dòng phân cách "Hoặc" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#3E424D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="15dp" android:text="Hoặc" android:textColor="#808080" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#3E424D" />
        </LinearLayout>

        <!-- Nút Google -->
        <LinearLayout
            android:id="@+id/BTN_GOOGLE"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_otp_box"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_google" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Tiếp tục với Google" android:textColor="@color/white" android:textSize="15sp" />
        </LinearLayout>

        <!-- Nút Facebook -->
        <LinearLayout
            android:id="@+id/BTN_FACEBOOK"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_otp_box"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_facebook" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Tiếp tục với Facebook" android:textColor="@color/white" android:textSize="15sp" />
        </LinearLayout>

        <!-- Nút Apple -->
        <LinearLayout
            android:id="@+id/BTN_APPLE"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_otp_box"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_apple" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Tiếp tục với Apple" android:textColor="@color/white" android:textSize="15sp" />
        </LinearLayout>

        <!-- Đăng ký -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chưa có tài khoản ? " android:textColor="#A0A0A0" />
            <TextView
                android:id="@+id/TV_DANG_KY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textColor="@color/XANH_NEON"
                android:textStyle="bold"
                android:padding="5dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>