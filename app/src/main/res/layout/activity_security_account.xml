    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lưu đăng nhập" android:textColor="#FFFFFF" android:textStyle="bold"/><Switch android:id="@+id/sw_save_login" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
