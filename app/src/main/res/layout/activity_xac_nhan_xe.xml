<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/DEN_NEN"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/HEADER_XAC_NHAN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/BTN_BACK_XAC_NHAN"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Chọn hãng"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/IMG_XE"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/HEADER_XAC_NHAN"
        android:layout_marginTop="40dp"
        android:src="@drawable/anh_dang_nhap" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/IMG_XE"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_otp_box"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/TXT_HANG_XE_XAC_NHAN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tesla"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#2A2D39" />

        <TextView
            android:id="@+id/TXT_MODEL_XE_XAC_NHAN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Model S"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#2A2D39" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="40"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/BTN_THEM_MOI_XE"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/XANH_NEON"
        android:text="Thêm mới"
        android:textColor="@color/white"
        app:cornerRadius="30dp" />
</RelativeLayout>