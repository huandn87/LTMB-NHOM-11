<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/DEN_NEN"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/TV_TITLE_HOSO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoàn thiện Hồ sơ 📋"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đừng lo lắng, chỉ có bạn mới được nhìn thấy các thông tin cá nhân của mình."
            android:textColor="#A0A0A0" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/IMG_AVATAR"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:padding="2dp"
            android:src="@drawable/avatar"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/XANH_NEON"
            app:strokeWidth="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Họ và tên"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/EDT_HO_TEN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/XANH_NEON"
            android:hint="Adam Nguyễn"
            android:textColor="@color/white"
            android:textColorHint="#404040" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/EDT_EMAIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/XANH_NEON"
            android:hint="adamnguyen@gmail.com"
            android:textColor="@color/white"
            android:textColorHint="#404040" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Giới tính"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SPN_GIOI_TINH"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <ProgressBar
            android:id="@+id/progress_bar_hoso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BTN_TIEP_TUC_HOSO"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/XANH_NEON"
            android:text="Tiếp tục"
            android:textColor="@color/white"
            app:cornerRadius="30dp" />
    </LinearLayout>
</ScrollView>