<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_station"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    android:layout_margin="10dp"
    android:visibility="gone"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1C1E"> <TextView
    android:id="@+id/txtStationName"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Trạm sạc số 1"
    android:textColor="@color/white"
    android:textSize="18sp"
    android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStationAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Địa chỉ trạm sạc..."
        android:textColor="#9E9E9E" />

    <Button
        android:id="@+id/btnNavigateMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00A859"
        android:text="Chỉ dẫn"
        android:textColor="@color/white" />
</LinearLayout>
</androidx.cardview.widget.CardView>