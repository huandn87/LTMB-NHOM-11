<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="98dp" android:layout_marginBottom="16dp">
    <LinearLayout android:layout_width="86dp" android:layout_height="78dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_delete_red" android:gravity="center">
        <ImageView android:id="@+id/btn_vehicle_delete" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_delete" android:tint="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/vehicle_foreground" android:layout_width="match_parent" android:layout_height="78dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_account_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:layout_width="58dp" android:layout_height="44dp" android:scaleType="centerCrop" android:src="@drawable/ic_car_red"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txt_vehicle_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VinFast" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txt_vehicle_model" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VF 8" android:textColor="#A9ABB2" android:textSize="12sp"/>
        </LinearLayout>
        <ImageView android:id="@+id/btn_vehicle_arrow" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp" android:src="@android:drawable/ic_media_next" android:tint="#FFFFFF"/>
    </LinearLayout>
</FrameLayout>
