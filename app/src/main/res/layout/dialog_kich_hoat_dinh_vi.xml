<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_otp_box"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/location" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Kích hoạt định vị"
        android:textColor="@color/XANH_NEON"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Chúng tôi cần truy cập vào vị trí của bạn để tìm kiếm trạm sạc xung quanh bạn."
        android:textColor="#A0A0A0"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/BTN_DONG_Y_DINH_VI"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/XANH_NEON"
        android:text="Kích hoạt định vị"
        android:textColor="@color/white"
        app:cornerRadius="28dp" />

    <TextView
        android:id="@+id/BTN_HUY_DINH_VI"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Huỷ"
        android:textColor="#808080"
        android:textSize="16sp" />
</LinearLayout>