<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VoltApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/XANH_NEON</item>
        <item name="colorPrimaryVariant">@color/XANH_NEON</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/DEN_NEN</item>
    </style>
    <style name="CircleImage" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>
    <style name="AccountRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:gravity">center_vertical</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="InfoLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">22dp</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item></style>
    <style name="InfoValue"><item name="android:layout_width">match_parent</item><item name="android:layout_height">46dp</item><item name="android:gravity">center_vertical</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item></style>
    <style name="LangRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item></style>
    <style name="LangText"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">21sp</item></style>
    <style name="LangCheck"><item name="android:layout_width">40dp</item><item name="android:layout_height">wrap_content</item><item name="android:gravity">center</item><item name="android:textColor">#01B763</item><item name="android:textSize">22sp</item></style>

    <style name="CircleFAB">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="WalletChipButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">@color/brand_green</item>
    </style>

    <style name="WalletKeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AccountRowV2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="AccountTextV2">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_alignParentStart">true</item>
    </style>
    <style name="AccountArrowV2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#808080</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_alignParentEnd">true</item>
    </style>
    <style name="AccountDividerV2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:background">#2D3038</item>
    </style>
</resources>
